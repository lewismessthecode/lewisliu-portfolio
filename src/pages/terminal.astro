---
import Desktop from '../components/Desktop'
import { getSiteData } from '../lib/site-data'
import '../styles/terminal.css'
import '../styles/win98.css'
import '../styles/backgrounds.css'
import '../styles/matrix-rain.css'

const siteData = await getSiteData()
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Terminal · Lewis Liu</title>
    <meta name="description" content="Explore Lewis Liu's terminal." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="portfolio-return" href="/">← Portfolio</a>
    <Desktop client:load data={siteData} />
    <noscript><p class="terminal-noscript">The terminal needs JavaScript. <a href="/">Return to the portfolio</a>.</p></noscript>
  </body>
</html>
<style is:global>
  .portfolio-return { position: fixed; z-index: 100; top: 8px; right: 12px; padding: 6px 10px; background: #c0c0c0; color: #111; font: 14px system-ui, sans-serif; border: 2px solid; border-color: #fff #555 #555 #fff; text-decoration: none; }
  .portfolio-return:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
  .terminal-noscript { padding: 60px 16px; color: #fff; }
  .terminal-noscript a { color: #fff; }
  @media (max-width: 768px) {
    .portfolio-return { top: 4px; right: 4px; min-height: 44px; display: inline-flex; align-items: center; font-size: 12px; }
    .terminal-wrapper { min-width: 0; }
    .terminal-output { padding-top: 56px; }
  }
</style>
