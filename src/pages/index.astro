---
import { getSiteData, profile } from '../lib/site-data'
import '../styles/portfolio.css'

const data = await getSiteData()
const featured = data.projects
  .filter((project) => project.featuredOrder !== undefined)
  .sort((a, b) => (a.featuredOrder ?? 99) - (b.featuredOrder ?? 99))
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lewis Liu · Software engineer</title>
    <meta name="description" content={profile.description} />
    <meta property="og:title" content="Lewis Liu · Software engineer" />
    <meta property="og:description" content={profile.description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href="https://lewisliu.space/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      if (new URLSearchParams(window.location.search).has('cmd')) {
        window.location.replace('/terminal' + window.location.search + window.location.hash)
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="desktop">
      <aside class="desktop-rail" aria-label="Desktop shortcuts">
        <a href="#work"><span class="desktop-icon folder-icon" aria-hidden="true"></span><span>Work</span></a>
        <a href="/terminal"><span class="desktop-icon prompt-icon" aria-hidden="true">&gt;_</span><span>Terminal</span></a>
      </aside>
      <div class="window">
        <div class="titlebar"><span class="titlebar-mark" aria-hidden="true">▣</span><span>Lewis Liu</span><span class="titlebar-path">C:\LEWIS\PORTFOLIO</span></div>
        <header class="menu-bar">
          <a class="wordmark" href="#top">Lewis Liu<span class="wordmark-dot">.</span></a>
          <nav aria-label="Main navigation">
            <a href="#work">Work</a><a href="#about">About</a><a href="#contact">Contact</a><a class="terminal-link" href="/terminal"><span aria-hidden="true">&gt;_</span> Terminal</a>
          </nav>
        </header>
        <main id="main">
          <section class="intro" id="top">
            <div class="intro-copy">
              <p class="eyebrow"><span class="pixel-square" aria-hidden="true"></span>{profile.role}</p>
              <h1>Lewis Liu</h1>
              <p class="intro-description">{profile.description}</p>
            </div>
          </section>
          <section class="work-section" id="work" aria-labelledby="work-heading">
            <div class="section-heading"><h2 id="work-heading">Selected work</h2></div>
            <div class="project-list">
              {featured.map((project, index) => (
                <article class="project">
                  <div class="project-image">
                    <div class="image-titlebar"><span class="image-title">{project.title}</span><span aria-hidden="true">▰</span></div>
                    <a href={project.github} aria-label={`View ${project.title} on GitHub`}>
                      <img src={project.image} alt={`${project.title} application screenshot`} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
                    </a>
                  </div>
                  <div class="project-info">
                    <h3>{project.title}</h3>
                    <p>{project.description}</p>
                    <div class="project-links">
                      {project.github && <a href={project.github}>GitHub <span aria-hidden="true">↗</span></a>}
                      {project.demo && <a href={project.demo}>Website <span aria-hidden="true">↗</span></a>}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>
          <section class="about-section" id="about" aria-labelledby="about-heading">
            <div class="section-heading"><h2 id="about-heading">About</h2></div>
            <div class="about-body"><p>{profile.bio}</p><a href="/terminal?cmd=resume">More in the terminal <span aria-hidden="true">↗</span></a></div>
          </section>
          <section class="contact-section" id="contact" aria-labelledby="contact-heading">
            <div class="section-heading"><h2 id="contact-heading">Contact</h2></div>
            <div class="contact-links"><a href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a><a href={`https://github.com/${profile.github}`}>GitHub <span aria-hidden="true">↗</span></a><a href={`https://x.com/${profile.twitter}`}>X <span aria-hidden="true">↗</span></a></div>
          </section>
        </main>
        <footer class="window-footer"><span>Lewis Liu</span><a href="/terminal?cmd=garden">Notes &amp; writing ↗</a></footer>
      </div>
      <footer class="taskbar"><a href="#top" class="taskbar-home"><span aria-hidden="true">▦</span> Lewis Liu</a><span class="taskbar-divider"></span><span class="taskbar-window">▣ &nbsp; Portfolio</span><a href="/terminal" class="taskbar-terminal">&gt;_ &nbsp; Terminal</a></footer>
    </div>
  </body>
</html>
