---
import Desktop from './Desktop'
import Portfolio from './Portfolio.astro'
import { getSiteData, profile } from '../lib/site-data'
import enResumeHtml from '../data/resume/resume.en.html?raw'
import zhResumeHtml from '../data/resume/resume.zh.html?raw'
import '../styles/terminal.css'
import '../styles/win98.css'
import '../styles/backgrounds.css'
import '../styles/matrix-rain.css'
import '../styles/portfolio.css'
import '../styles/resume.css'
import '../styles/desktop.css'
const data = await getSiteData()
const resumeBody = (html: string) => html.match(/<main>([\s\S]*?)<\/main>/)?.[1].trim() ?? ''
const resumePages = { en: resumeBody(enResumeHtml), zh: resumeBody(zhResumeHtml) }
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Lewis Liu · Software engineer</title>
    <meta name="description" content={profile.description} />
    <meta property="og:title" content="Lewis Liu · Software engineer" />
    <meta property="og:description" content={profile.description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href="https://lewisliu.space/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Desktop client:load data={data} resumePages={resumePages}><Portfolio /></Desktop>
  </body>
</html>
