---
import { getSiteData, profile } from '../lib/site-data'
const data = await getSiteData()
const featured = data.projects.filter((project) => project.featuredOrder !== undefined)
  .sort((a, b) => (a.featuredOrder ?? 99) - (b.featuredOrder ?? 99))
---
<div class="portfolio-content">
  <header class="portfolio-nav">
    <a class="portfolio-wordmark" href="#top">Lewis Liu</a>
    <nav aria-label="Portfolio navigation">
      <a href="#work">Work</a><a href="#about">About</a><a href="#contact">Contact</a>
    </nav>
  </header>
  <main id="main">
    <section class="portfolio-intro" id="top">
      <p class="portfolio-role">{profile.role}</p>
      <h1>Lewis Liu</h1>
      <p>{profile.description}</p>
    </section>
    <section id="work" aria-labelledby="work-heading">
      <h2 id="work-heading" class="portfolio-section-title">Selected work</h2>
      <div class="portfolio-projects">
        {featured.map((project, index) => (
          <article class="portfolio-project">
            <a class="portfolio-image" href={project.github} aria-label={`View ${project.title} on GitHub`}>
              <span class="portfolio-image-title">{project.title}</span>
              <img src={project.image} alt={`${project.title} application screenshot`} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
            </a>
            <div class="portfolio-project-info">
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <div class="portfolio-project-links">
                {project.github && <a href={project.github}>GitHub ↗</a>}
                {project.demo && <a href={project.demo}>Website ↗</a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
    <section class="portfolio-about" id="about" aria-labelledby="about-heading">
      <h2 class="portfolio-section-title" id="about-heading">About</h2>
      <div class="portfolio-about-body"><p>{profile.bio}</p></div>
    </section>
    <section class="portfolio-contact" id="contact" aria-labelledby="contact-heading">
      <h2 class="portfolio-section-title" id="contact-heading">Contact</h2>
      <div class="portfolio-contact-links"><a href={`mailto:${profile.email}`}>{profile.email} ↗</a><a href={`https://github.com/${profile.github}`}>GitHub ↗</a><a href={`https://x.com/${profile.twitter}`}>X ↗</a></div>
    </section>
  </main>
  <footer class="portfolio-footer"><span>Lewis Liu</span>{data.garden.length > 0 && <a href="/terminal?cmd=garden" data-terminal="garden">Notes &amp; writing ↗</a>}</footer>
</div>
